        <mxCell id="cell-5-3" value="给可执行安排" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFFFFF;strokeColor=#D6E3DE;fontColor=#17332E;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="668" y="496" width="221" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cell-5-4" value="校验时间、资格与报名条件。公开开放日和私享体验分开，未确认受邀时不引导私享入场。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFFFFF;strokeColor=#D6E3DE;fontColor=#17332E;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=13;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="889" y="496" width="622" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cell-6-0" value="PO · 价格异议" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#F2F7F5;strokeColor=#D6E3DE;fontColor=#17332E;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=13;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="49" y="568" width="177" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cell-6-1" value="说清价格边界" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#F2F7F5;strokeColor=#D6E3DE;fontColor=#17332E;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="226" y="568" width="221" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cell-6-2" value="核实条件或解释差异" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#F2F7F5;strokeColor=#D6E3DE;fontColor=#17332E;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="447" y="568" width="221" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cell-6-3" value="按预算给取舍" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#F2F7F5;strokeColor=#D6E3DE;fontColor=#17332E;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="668" y="568" width="221" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cell-6-4" value="区分目录价与未核实优惠，保留客户预算。竞品、价差成因、替代品和携带频率各自需要依据。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#F2F7F5;strokeColor=#D6E3DE;fontColor=#17332E;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=13;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="889" y="568" width="622" height="72" as="geometry" />
        </mxCell>
        <mxCell id="special" value="专用分路适用于主动邀约、只问候、只求挑法，并按任务裁剪公开陈列与老客问候的提示词证据。" style="text;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fontColor=#17332E;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;connectable=0;" vertex="1" parent="1">
