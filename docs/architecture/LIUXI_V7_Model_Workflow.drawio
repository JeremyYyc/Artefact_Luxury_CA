        <mxCell id="slot2" value="&lt;b&gt;槽位 2 · 场景策略 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#17332E;line-height:1.35'&gt;draft_reply&lt;br&gt;生成 + 本地初检&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#E5F4EF;strokeColor=#82B8A9;strokeWidth=1.4;fontSize=15;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="604" y="308" width="202" height="72" as="geometry" />
        </mxCell>
        <mxCell id="slot3" value="&lt;b&gt;槽位 3 · 场景策略 3&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#17332E;line-height:1.35'&gt;draft_reply&lt;br&gt;生成 + 本地初检&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#E5F4EF;strokeColor=#82B8A9;strokeWidth=1.4;fontSize=15;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="828" y="308" width="202" height="72" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;review_replies · 首轮整组模型审阅&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;校验 JSON、槽位顺序与判退结果&lt;br&gt;合并各槽预检，再按动作与正文判重&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#EBF1F9;strokeColor=#A1B5D2;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="470" y="431" width="470" height="89" as="geometry" />
        </mxCell>
        <mxCell id="fallback" value="&lt;b&gt;审阅失败时回退到 local_review&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#663F19;line-height:1.35'&gt;超时、上游错误或输出无效&lt;br&gt;使用已有预检结果和整组代码判重&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFF4E3;strokeColor=#D8AE76;strokeWidth=1.4;fontSize=15;fontColor=#663F19;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1100" y="433" width="385" height="87" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;还有失败槽位？&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;读取 rerun_slots&lt;/span&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#EBF1F9;strokeColor=#A1B5D2;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="545" y="573" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="retry-gate" value="&lt;b&gt;有失败槽位已达第 3 次？&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#663F19;line-height:1.35'&gt;初稿 1 次 + 补写最多 2 次&lt;/span&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFF4E3;strokeColor=#D8AE76;strokeWidth=1.4;fontSize=16;fontColor=#663F19;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="527" y="734" width="356" height="101" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="&lt;b&gt;END · 交付三条有序回复&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#17332E;line-height:1.35'&gt;按槽位标记 review_status&lt;br&gt;passed · 原稿通过模型审阅流程&lt;br&gt;local_only · 原稿通过规则回退&lt;br&gt;regenerated · 补写通过复检&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#E5F4EF;strokeColor=#82B8A9;strokeWidth=1.4;fontSize=15;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="46" y="563" width="283" height="118" as="geometry" />
        </mxCell>
        <mxCell id="failed" value="&lt;b&gt;END · 无法交付完整三条&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#792F2A;line-height:1.35'&gt;失败槽含 504 则返回超时&lt;br&gt;否则含 429 则返回限流&lt;br&gt;其余返回 502&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FCEEEB;strokeColor=#D5A29B;strokeWidth=1.4;fontSize=16;fontColor=#792F2A;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="470" y="919" width="470" height="99" as="geometry" />
        </mxCell>
        <mxCell id="retain" value="&lt;b&gt;保留本轮已通过槽位&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#663F19;line-height:1.35'&gt;反馈携带 issues、passed_replies&lt;br&gt;及可用的 occupied_actions&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFF4E3;strokeColor=#D8AE76;strokeWidth=1.4;fontSize=15;fontColor=#663F19;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1114" y="710" width="350" height="73" as="geometry" />
        </mxCell>
        <mxCell id="retry" value="&lt;b&gt;regenerate_reply&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#17332E;line-height:1.35'&gt;仅派发失败槽位 · attempt + 1&lt;br&gt;复用 draft_reply 和同一套预检&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#E5F4EF;strokeColor=#82B8A9;strokeWidth=1.4;fontSize=15;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1114" y="811" width="350" height="73" as="geometry" />
        </mxCell>
        <mxCell id="recheck" value="&lt;b&gt;check_regenerated&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#17332E;line-height:1.35'&gt;本地复查整组预检和判重&lt;br&gt;有冲突时优先保留已通过槽位&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#EBF1F9;strokeColor=#A1B5D2;strokeWidth=1.4;fontSize=15;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1114" y="913" width="350" height="77" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;每个生成槽位做什么&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#17332E;line-height:1.35'&gt;按场景与槽位拼装提示词&lt;br&gt;加入必答点、事实边界与补写反馈&lt;br&gt;DeepSeek 返回 JSON 后验证格式&lt;br&gt;预检事实、安全、策略及必要答复&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFFFFF;strokeColor=#B9CDC6;strokeWidth=1.4;fontSize=15;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="46" y="230" width="283" height="147" as="geometry" />
        </mxCell>
        <mxCell id="checks" value="&lt;b&gt;整组判重依据&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#17332E;line-height:1.35'&gt;识别重复的后续动作&lt;br&gt;正文相同或规范化相似度达阈值&lt;br&gt;优先保留已通过且兼容的组合&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFFFFF;strokeColor=#B9CDC6;strokeWidth=1.4;fontSize=15;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
