        <mxCell id="start" value="&lt;b&gt;START · 场景与共享上下文就绪&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#D2E9DE;line-height:1.35'&gt;first_batch 为槽位 1、2、3 创建 Send 任务&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#193C33;strokeColor=#193C33;strokeWidth=1.4;fontSize=16;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
