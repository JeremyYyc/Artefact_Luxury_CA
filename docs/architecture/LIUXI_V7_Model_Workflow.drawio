        <mxCell id="deps-label" value="资料与模型  /  服务端依赖" style="text;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fontColor=#227B6C;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1167" y="163" width="330" height="25" as="geometry" />
        </mxCell>
        <mxCell id="form" value="&lt;b&gt;顾问填写并提交&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;六个预设或自由输入&lt;br&gt;顾问任务或顾客待回复消息&lt;br&gt;历史对话与本轮相关资料&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFFFFF;strokeColor=#B9CDC6;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="67" y="361" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="hydrate" value="&lt;b&gt;初始化工作台&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;GET /api/presets 与 /api/library&lt;br&gt;载入示例及可选资料&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFFFFF;strokeColor=#B9CDC6;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="67" y="221" width="320" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ui-success" value="&lt;b&gt;显示三条候选微信话术&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;顾问查看依据、编辑并复制&lt;br&gt;补写稿或仅规则检查稿提示复核&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#E5F4EF;strokeColor=#82B8A9;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="67" y="706" width="320" height="94" as="geometry" />
        </mxCell>
        <mxCell id="ui-error" value="&lt;b&gt;保留输入并提示顾问处理&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#792F2A;line-height:1.35'&gt;422 补充资料或澄清意图&lt;br&gt;429 稍后重试 · 502 生成失败&lt;br&gt;504 请求超时 · 503 模型未配置&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FCEEEB;strokeColor=#D5A29B;strokeWidth=1.4;fontSize=15;fontColor=#792F2A;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="67" y="845" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="static" value="&lt;b&gt;从 GitHub main 构建并发布&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#D2E9DE;line-height:1.35'&gt;Vite 构建 frontend/dist&lt;br&gt;FastAPI 同源托管静态文件与 /api/*&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#193C33;strokeColor=#193C33;strokeWidth=1.4;fontSize=16;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="210" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;POST /api/generate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;Pydantic 校验输入 · 记录 request_id&lt;br&gt;模型就绪后启用总时限，默认 30 秒&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#EBF1F9;strokeColor=#A1B5D2;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="327" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="routing" value="&lt;b&gt;确定本轮场景&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;已选场景直接使用 · 自由输入调用模型识别&lt;br&gt;意图不明确时返回澄清问题&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#EBF1F9;strokeColor=#A1B5D2;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="443" width="520" height="74" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;Resources.prepare 组装本轮证据&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;关联所选客户、商品及活动 · 裁剪字段&lt;br&gt;按上海时间核查库存快照与活动状态&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#EBF1F9;strokeColor=#A1B5D2;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="552" width="520" height="78" as="geometry" />
        </mxCell>
        <mxCell id="graph" value="&lt;b&gt;LangGraph 生成并检查候选&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;三条并发生成 · 一次整组模型审阅&lt;br&gt;仅补写失败槽位 · 逐轮执行代码复检&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#E5F4EF;strokeColor=#82B8A9;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="667" width="520" height="83" as="geometry" />
        </mxCell>
        <mxCell id="response" value="&lt;b&gt;HTTP 200 · GenerateResponse&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;三个按槽位排序的 options、routing、basis&lt;br&gt;附 request_id、scenario 和 workflow_version&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#E5F4EF;strokeColor=#82B8A9;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="792" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="error" value="&lt;b&gt;API 异常响应&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#792F2A;line-height:1.35'&gt;输入或执行失败时返回对应状态与提示&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FCEEEB;strokeColor=#D5A29B;strokeWidth=1.4;fontSize=15;fontColor=#792F2A;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="906" width="520" height="48" as="geometry" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;只读 JSON 资料&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;客户档案 · 商品目录与护理条目&lt;br&gt;活动目录 · 六个预设&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFFFFF;strokeColor=#B9CDC6;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1170" y="215" width="324" height="99" as="geometry" />
        </mxCell>
        <mxCell id="prompts" value="&lt;b&gt;liuxi_v3.json&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;六场景的三路策略&lt;br&gt;路由、生成、审阅及 JSON Schema&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#FFFFFF;strokeColor=#B9CDC6;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1170" y="397" width="324" height="95" as="geometry" />
        </mxCell>
        <mxCell id="model" value="&lt;b&gt;DeepSeek API · deepseek-flash&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#17332E;line-height:1.35'&gt;路由按需调用，生成与审阅共用模型&lt;br&gt;模型凭证保存在 Vercel 服务端&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#EBF1F9;strokeColor=#A1B5D2;strokeWidth=1.4;fontSize=16;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
