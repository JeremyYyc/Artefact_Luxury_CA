        </mxCell>
        <mxCell id="slot1" value="&lt;b&gt;槽位 1 · 场景策略 1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#17332E;line-height:1.35'&gt;draft_reply&lt;br&gt;生成 + 本地初检&lt;/span&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sans-serif;fillColor=#E5F4EF;strokeColor=#82B8A9;strokeWidth=1.4;fontSize=15;fontColor=#17332E;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
